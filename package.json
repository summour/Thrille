{
  "name": "thrille",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thrille — Offline-first reader for the Thai Civil and Commercial Code (UX/UI prototype)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:law": "tsx scripts/import.ts",
    "import:law:check": "tsx scripts/import.ts --check",
    "import:cpc": "tsx scripts/import.ts --law=cpc",
    "import:cpc:check": "tsx scripts/import.ts --law=cpc --check",
    "import:penal": "tsx scripts/import.ts --law=penal-code",
    "import:penal:check": "tsx scripts/import.ts --law=penal-code --check",
    "import:penal-code": "tsx scripts/import.ts --law=penal-code",
    "import:penal-code:check": "tsx scripts/import.ts --law=penal-code --check",
    "import:crpc": "tsx scripts/import.ts --law=crpc",
    "import:crpc:check": "tsx scripts/import.ts --law=crpc --check",
    "import:state-admin": "tsx scripts/import.ts --law=state-admin",
    "import:state-admin:check": "tsx scripts/import.ts --law=state-admin --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}